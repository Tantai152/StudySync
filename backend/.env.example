# Server
NODE_ENV=development
PORT=3000

# Database (MySQL 8) — chỉ điền giá trị mẫu, KHÔNG commit file .env thật
DATABASE_URL="mysql://studysync:studysync@localhost:3306/studysync"

# CORS — origin của frontend, có thể nhiều origin phân tách bằng dấu phẩy
# Không có dấu "/" ở cuối. Production bắt buộc khác localhost.
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL=https://studywithme.io.vn,https://study-sync-gilt-ten.vercel.app

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-me
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-me
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Groq (Whisper STT)
GROQ_API_KEY=your-groq-api-key-change-me